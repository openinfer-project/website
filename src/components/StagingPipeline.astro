---
/**
 * StagingPipeline — 权重加载博客的 two-slot pinned staging 动画（第 4 节）。
 *
 * 两块 64 MiB pinned slot 的 producer/consumer 循环，fill : H2D 时长按
 * 32.6 : 51.5 GiB/s 的反比绘制，滚入视口后循环播放。
 *
 * 无 JS / prefers-reduced-motion 时渲染最终静态帧。
 */
interface Block {
	start: number;
	end: number;
	cls: string;
	label?: string;
}
interface Lane {
	label: string;
	sub?: string;
	blocks: Block[];
}

const F = 1;
const T = 32.6 / 51.5;
const chunks = 8;
const fills: Block[] = [];
const h2ds: Block[] = [];
const bubbles: Block[] = [];
let gpuFree = 0;
const slotFree = [0, 0];
for (let i = 0; i < chunks; i++) {
	const slot = i % 2;
	const fs = Math.max(i > 0 ? fills[i - 1].end : 0, slotFree[slot]);
	const fe = fs + F;
	fills.push({ start: fs, end: fe, cls: slot === 0 ? 'fa' : 'fb', label: `fill ${'AB'[slot]}` });
	const hs = Math.max(fe, gpuFree);
	if (hs > gpuFree) bubbles.push({ start: gpuFree, end: hs, cls: 'bubble' });
	const he = hs + T;
	h2ds.push({ start: hs, end: he, cls: slot === 0 ? 'da' : 'db', label: `H2D ${'AB'[slot]}` });
	gpuFree = he;
	slotFree[slot] = he;
}
const duration = gpuFree + 0.35;
const animMs = Math.round(duration * 900);
const lanes: Lane[] = [
	{ label: 'CPU', sub: 'fill (4 threads)', blocks: fills },
	{ label: 'GPU', sub: 'H2D (single stream)', blocks: [...h2ds, ...bubbles] },
];

const pct = (t: number) => ((t / duration) * 100).toFixed(3);
const caption =
	'Fill : H2D drawn to scale (32.6 : 51.5 GiB/s); dashed gaps in the GPU lane are DMA bubbles.';
---

<figure class="sp" data-sp data-anim-ms={animMs} role="img" aria-label={caption}>
	<div class="sp-legend">
		<span class="sp-chip fa" />
		<span>slot A (64 MiB pinned)</span>
		<span class="sp-chip fb" />
		<span>slot B (64 MiB pinned)</span>
		<span class="sp-chip dm" />
		<span>H2D</span>
	</div>
	<div class="sp-slots">
		<span class="sp-slot sa">
			<b>slot A</b>
			<em data-slot="0">idle</em>
		</span>
		<span class="sp-slot sb">
			<b>slot B</b>
			<em data-slot="1">idle</em>
		</span>
		<span class="sp-phase" data-phase />
	</div>
	<div class="sp-body">
		{
			lanes.map((lane) => (
				<div class="sp-row">
					<div class="sp-lane-label">
						{lane.label}
						{lane.sub && <span>{lane.sub}</span>}
					</div>
					<div class="sp-lane">
						{lane.blocks.map((b) => (
							<div
								class={`sp-block ${b.cls}`}
								style={`left:${pct(b.start)}%;width:${pct(b.end - b.start)}%`}
								data-start={pct(b.start)}
								data-end={pct(b.end)}
							>
								<i />
								{b.label && <em>{b.label}</em>}
							</div>
						))}
						<div class="sp-cursor" />
					</div>
				</div>
			))
		}
	</div>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.sp {
		--sp-a: #526cfe;
		--sp-b: #e64a1d;
		margin: 1.5rem 0;
		padding: 1rem 1.25rem 0.875rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		background: var(--sl-color-bg);
		position: relative;
	}
	:global(:root[data-theme='dark']) .sp {
		--sp-a: #8b9cff;
		--sp-b: #ff8a55;
	}

	.sp-legend {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.5rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		margin-bottom: 0.75rem;
	}
	.sp-legend > span:not(.sp-chip) {
		margin-right: 0.75rem;
	}
	.sp-chip {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 2px;
		display: inline-block;
	}
	.sp-chip.fa {
		background: var(--sp-a);
	}
	.sp-chip.fb {
		background: var(--sp-b);
	}
	.sp-chip.dm {
		background: repeating-linear-gradient(45deg, var(--sp-a) 0 2px, transparent 2px 5px);
		border: 1px solid var(--sp-a);
	}

	.sp-body {
		position: relative;
	}
	/* 抵消 Starlight markdown 的 flow margin，避免绝对定位块高度被吃掉 */
	.sp-body,
	.sp-row,
	.sp-lane,
	.sp-block,
	.sp-block i,
	.sp-block em,
	.sp-cursor,
	.sp-chip,
	.sp-legend,
	.sp figcaption {
		margin: 0;
	}
	.sp-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}
	.sp-lane-label {
		flex: 0 0 9.5rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-gray-1);
		line-height: 1.35;
	}
	.sp-lane-label span {
		display: block;
		font-weight: 400;
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
	}
	.sp-lane {
		flex: 1;
		position: relative;
		height: 2.125rem;
		background: var(--sl-color-bg-sidebar);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.25rem;
	}

	.sp-block {
		position: absolute;
		top: 3px;
		bottom: 3px;
		border-radius: 2px;
		overflow: hidden;
	}
	.sp-block i {
		display: block;
		position: relative;
		height: 100%;
		width: 100%;
		border-radius: 2px;
	}
	.sp-block em {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--sl-font-mono);
		font-size: 0.625rem;
		font-style: normal;
		color: #fff;
		pointer-events: none;
		white-space: nowrap;
	}

	.sp-block.fa i {
		background: var(--sp-a);
	}
	.sp-block.fb i {
		background: var(--sp-b);
	}
	.sp-block.da i {
		background: repeating-linear-gradient(45deg, var(--sp-a) 0 3px, transparent 3px 8px);
	}
	.sp-block.db i {
		background: repeating-linear-gradient(45deg, var(--sp-b) 0 3px, transparent 3px 8px);
	}
	.sp-block.da em,
	.sp-block.db em {
		display: none;
	}

	.sp-cursor {
		display: none;
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--sl-color-gray-2);
		opacity: 0.55;
		pointer-events: none;
	}

	/* 动画态（JS 加 .sp-anim）：默认静态帧 = 全部填满 + 标签可见 */
	.sp-anim .sp-block i {
		width: 0;
	}
	.sp-anim .sp-block em {
		opacity: 0;
		transition: opacity 0.2s;
	}
	.sp-anim .sp-block.done em,
	.sp-anim .sp-block.active em {
		opacity: 1;
	}
	.sp-anim .sp-cursor {
		display: block;
	}

	.sp figcaption {
		margin-top: 0.625rem;
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}

	/* slot 状态条 */
	.sp-slots {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.625rem;
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
	}
	.sp-slot {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--sl-color-gray-3);
	}
	.sp-slot b {
		font-weight: 700;
		padding: 0.1rem 0.4rem;
		border-radius: 2px;
		color: #fff;
	}
	.sp-slot.sa b {
		background: var(--sp-a);
	}
	.sp-slot.sb b {
		background: var(--sp-b);
	}
	.sp-slot em {
		font-style: normal;
	}
	.sp-slot.busy {
		color: var(--sl-color-gray-1);
	}
	.sp-phase {
		color: var(--sl-color-gray-3);
	}

	/* GPU 道空隙 = DMA bubble */
	.sp-block.bubble {
		border: 1px dashed var(--sl-color-gray-4);
		background: transparent;
	}
	.sp-block.bubble i {
		background: transparent;
	}
	.sp-anim .sp-block.bubble i {
		width: 100%;
	}
	.sp-block.bubble em,
	.sp-anim .sp-block.bubble em {
		display: none;
	}

	/* 进行中的块：传送带条纹 + 描边，两条道同时亮起即重叠 */
	.sp-anim .sp-block.active {
		box-shadow: 0 0 0 1px var(--sl-color-gray-1);
		z-index: 1;
	}
	.sp-anim .sp-block.active i::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: linear-gradient(
			45deg,
			rgba(255, 255, 255, 0.28) 25%,
			transparent 25%,
			transparent 50%,
			rgba(255, 255, 255, 0.28) 50%,
			rgba(255, 255, 255, 0.28) 75%,
			transparent 75%
		);
		background-size: 14px 14px;
		animation: sp-stripes 0.6s linear infinite;
	}
	@keyframes sp-stripes {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 14px 0;
		}
	}

	@media (max-width: 40rem) {
		.sp-lane-label {
			flex-basis: 6.5rem;
		}
		.sp-block em {
			display: none;
		}
	}
</style>

<script>
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduced) {
		document.querySelectorAll<HTMLElement>('[data-sp]').forEach((root) => {
			const animMs = Number(root.dataset.animMs || 8000);
			root.classList.add('sp-anim');

			const blocks = Array.from(root.querySelectorAll<HTMLElement>('.sp-block')).filter(
				(b) => !b.classList.contains('bubble'),
			);
			const fills = blocks.map((b) => b.querySelector<HTMLElement>('i')!);
			const cursors = Array.from(root.querySelectorAll<HTMLElement>('.sp-cursor'));
			const slotEls = Array.from(root.querySelectorAll<HTMLElement>('[data-slot]'));
			const phaseEl = root.querySelector<HTMLElement>('[data-phase]');
			const sched = blocks
				.map((b) => {
					const m = b.className.match(/\b([fd])([ab])\b/);
					return m
						? {
								slot: m[2] === 'a' ? 0 : 1,
								kind: (m[1] === 'f' ? 'fill' : 'h2d') as 'fill' | 'h2d',
								s: Number(b.dataset.start),
								e: Number(b.dataset.end),
							}
						: null;
				})
				.filter((x) => x !== null);

			let raf = 0;
			let t0 = 0;
			let playing = false;

			const render = (now: number) => {
				if (!t0) t0 = now;
				let el = now - t0;
				if (el >= animMs) {
					t0 = now;
					el = 0;
				}
				const t = (el / animMs) * 100;
				blocks.forEach((b, i) => {
					const s = Number(b.dataset.start);
					const e = Number(b.dataset.end);
					const p = t <= s ? 0 : t >= e ? 100 : ((t - s) / (e - s)) * 100;
					fills[i].style.width = p + '%';
					b.classList.toggle('active', t > s && t < e);
					b.classList.toggle('done', t >= e);
				});
				cursors.forEach((c) => (c.style.left = t + '%'));
				if (slotEls.length) {
					const cur: ('idle' | 'fill' | 'h2d')[] = ['idle', 'idle'];
					sched.forEach((sc) => {
						if (t > sc.s && t < sc.e) cur[sc.slot] = sc.kind;
					});
					slotEls.forEach((el) => {
						const st = cur[Number(el.dataset.slot)];
						el.textContent = st === 'fill' ? 'filling' : st === 'h2d' ? 'H2D' : 'idle';
						el.parentElement?.classList.toggle('busy', st !== 'idle');
					});
					if (phaseEl) {
						const fi = cur.indexOf('fill');
						const hi = cur.indexOf('h2d');
						phaseEl.textContent =
							fi >= 0 && hi >= 0
								? `overlap: fill ${'AB'[fi]} ‖ H2D ${'AB'[hi]}`
								: fi >= 0
									? `fill ${'AB'[fi]} · GPU idle (bubble)`
									: hi >= 0
										? `H2D ${'AB'[hi]} · CPU idle`
										: '';
					}
				}
				raf = requestAnimationFrame(render);
			};

			const start = () => {
				if (playing) return;
				playing = true;
				t0 = 0;
				raf = requestAnimationFrame(render);
			};
			const stop = () => {
				playing = false;
				cancelAnimationFrame(raf);
			};

			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((en) => {
						if (en.isIntersecting) {
							start();
						} else {
							stop();
						}
					});
				},
				{ threshold: 0.35 },
			);
			io.observe(root);
		});
	}
</script>
